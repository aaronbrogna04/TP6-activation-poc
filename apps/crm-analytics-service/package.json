{
  "name": "@poc/crm-analytics-service",
  "version": "0.1.0",
  "private": true,
  "description": "crm-analytics-service: consume los 4 topics de negocio desde el inicio y guarda una copia de cada evento en event_log. No publica eventos (RF-10).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/microservices": "11.2.8",
    "@nestjs/mongoose": "11.0.4",
    "@poc/contracts": "workspace:*",
    "@poc/kafka-toolkit": "workspace:*",
    "kafkajs": "2.2.4",
    "mongoose": "8.24.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
