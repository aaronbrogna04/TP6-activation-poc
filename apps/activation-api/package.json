{
  "name": "@poc/activation-api",
  "version": "0.1.0",
  "private": true,
  "description": "\u00danico punto de entrada: REST + agregador de la saga (y WebSocket en fase 2).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/microservices": "11.2.8",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/platform-express": "11.2.8",
    "@poc/contracts": "workspace:*",
    "@poc/kafka-toolkit": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "kafkajs": "2.2.4",
    "mongoose": "8.24.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "jest": "29.7.0",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    }
  }
}
